# ---------------------------------------------------------------------------
# Subaidar Hasnain Foundation — environment variables
# Copy this file to .env.local for local dev, and paste the same values into
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tkpgccgmpkmbynjwxgyw.supabase.co

# Supabase → Project Settings → API Keys → anon / publishable key.
# Safe to expose in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase → Project Settings → API Keys → service_role / secret key.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
# Used by /api/auth/register (creates the auth user) and admin-only endpoints.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public site URL (used for auth redirects / emails). Locally: http://localhost:5195
NEXT_PUBLIC_SITE_URL=http://localhost:5195

# ---------------------------------------------------------------------------
# Optional: Google AI Studio key for the admin assistant — aistudio.google.com/apikey
#
# The assistant works fully without this. Every figure it gives is read from
# Postgres either way; the key only lets a model read looser phrasing and word
# the reply. Setting it means the question and the supporting figures — which
# can include a member's name — are sent to Google. Leave it unset to keep all
# of that on the foundation's own infrastructure.
#
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
# GEMINI_API_KEY=YOUR_AI_STUDIO_KEY
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Optional: Brevo, for transactional email — brevo.com → SMTP & API → API Keys
#
# Free tier is 300 emails a day, which is far more than this foundation sends.
# The app runs exactly as it does today until both of these are set: no email
# is attempted, and nothing fails because of it.
#
# The from address must be a sender you have VERIFIED in Brevo, or every send
# is rejected. Brevo → Senders, Domains & Dedicated IPs → Senders.
#
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
# BREVO_API_KEY=YOUR_BREVO_KEY
# BREVO_FROM_EMAIL=noreply@yourdomain.com
# BREVO_FROM_NAME=Mohammad Husnain Foundation
